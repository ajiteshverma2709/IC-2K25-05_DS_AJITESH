
#include <iostream>
using namespace std;

int main() {
    int stack[100], top = -1;
    int n, pos, value;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> stack[i];
        top++;
    }

    cout << "Enter position to update (from bottom): ";
    cin >> pos;

    if(pos < 1 || pos > top + 1) {
        cout << "Invalid Position";
    }
    else {
        cout << "Enter new value: ";
        cin >> value;

        stack[pos - 1] = value;
        cout << "Element Updated Successfully";
    }

    cout << "\nStack: ";
    for(int i = top; i >= 0; i--) {
        cout << stack[i] << " ";
    }

    return 0;
}
