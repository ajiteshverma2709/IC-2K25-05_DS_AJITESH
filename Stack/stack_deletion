
#include <iostream>
using namespace std;

int main() {
    int stack[100], top = -1;
    int n, pos;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> stack[i];
        top++;
    }

    cout << "Enter position to delete (from bottom): ";
    cin >> pos;

    if(pos < 1 || pos > top + 1) {
        cout << "Invalid Position";
    }
    else {
        int index = pos - 1;

        cout << "Deleted element: " << stack[index];

        for(int i = index; i < top; i++) {
            stack[i] = stack[i + 1];
        }

        top--;
    }

    cout << "\nStack after deletion: ";

    for(int i = top; i >= 0; i--) {
        cout << stack[i] << " ";
    }

    return 0;
}
