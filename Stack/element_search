
#include <iostream>
using namespace std;

int main() {
    int stack[100], top = -1;
    int n, key, found = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> stack[i];
        top++;
    }

    cout << "Enter element to search: ";
    cin >> key;

    for(int i = top; i >= 0; i--) {
        if(stack[i] == key) {
            cout << "Element found at position "
                 << i + 1 << " from bottom";
            found = 1;
            break;
        }
    }

    if(found == 0) {
        cout << "Element not found";
    }

    return 0;
}
