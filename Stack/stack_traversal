
#include <iostream>
using namespace std;

int main() {
    int stack[100], top = -1;
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> stack[i];
        top++;
    }

    if(top == -1) {
        cout << "Stack is Empty";
    }
    else {
        cout << "Stack elements: ";

        for(int i = top; i >= 0; i--) {
            cout << stack[i] << " ";
        }
    }

    return 0;
}
