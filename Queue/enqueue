
#include <iostream>
using namespace std;

int main() {
    int queue[100];
    int front = -1, rear = -1;
    int n, value;

    cout << "Enter number of elements: ";
    cin >> n;

    for(int i = 0; i < n; i++) {
        if(rear == 99) {
            cout << "Queue Overflow";
            break;
        }

        cout << "Enter value: ";
        cin >> value;

        if(front == -1)
            front = 0;

        rear++;
        queue[rear] = value;
    }

    cout << "Queue: ";
    for(int i = front; i <= rear; i++) {
        cout << queue[i] << " ";
    }

    return 0;
}
