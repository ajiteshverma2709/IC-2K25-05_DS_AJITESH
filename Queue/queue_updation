
#include <iostream>
using namespace std;

int main() {
    int queue[100];
    int front = -1, rear = -1;
    int n, pos, value;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> queue[i];
        rear++;
    }

    if(n > 0)
        front = 0;

    cout << "Enter position to update: ";
    cin >> pos;

    if(pos < 1 || pos > rear - front + 1 || front == -1) {
        cout << "Invalid Position";
    }
    else {
        cout << "Enter new value: ";
        cin >> value;

        queue[front + pos - 1] = value;

        cout << "Element Updated Successfully";
    }

    cout << "\nQueue: ";
    if(front != -1) {
        for(int i = front; i <= rear; i++) {
            cout << queue[i] << " ";
        }
    }

    return 0;
}
