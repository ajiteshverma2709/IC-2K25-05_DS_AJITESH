
#include <iostream>
using namespace std;

int main() {
    int queue[100];
    int front = -1, rear = -1;
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> queue[i];
        rear++;
    }

    if(n > 0)
        front = 0;

    if(front == -1) {
        cout << "Queue is Empty";
    }
    else {
        cout << "Front element: " << queue[front];
    }

    return 0;
}
