
#include <iostream>
using namespace std;

int main() {
    int queue[100];
    int front = -1, rear = -1;
    int n, key, found = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++) {
        cin >> queue[i];
        rear++;
    }

    if(n > 0)
        front = 0;

    cout << "Enter element to search: ";
    cin >> key;

    for(int i = front; i <= rear && front != -1; i++) {
        if(queue[i] == key) {
            cout << "Element found at position " << i - front + 1;
            found = 1;
            break;
        }
    }

    if(found == 0) {
        cout << "Element not found";
    }

    return 0;
}
