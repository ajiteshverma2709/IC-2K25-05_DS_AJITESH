
#include <iostream>
#include <vector>
using namespace std;

vector<int> adj[20];
bool visited[20] = {false};

void DFS(int v) {

    visited[v] = true;

    for (int i = 0; i < adj[v].size(); i++) {

        int u = adj[v][i];

        if (!visited[u])
            DFS(u);
    }
}

int main() {

    int n, e;

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> e;

    for (int i = 0; i < e; i++) {

        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int components = 0;

    for (int i = 0; i < n; i++) {

        if (!visited[i]) {

            DFS(i);
            components++;
        }
    }

    cout << "Connected Components: "
         << components;

    return 0;
}
