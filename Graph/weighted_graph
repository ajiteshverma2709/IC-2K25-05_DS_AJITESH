
#include <iostream>
using namespace std;

int main() {

    int n, e;
    int adj[20][20] = {0};

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> e;

    for (int i = 0; i < e; i++) {

        int u, v, weight;

        cout << "Enter source, destination and weight: ";
        cin >> u >> v >> weight;

        adj[u][v] = weight;
        adj[v][u] = weight;
    }

    cout << "\nWeighted Adjacency Matrix:\n";

    for (int i = 0; i < n; i++) {

        for (int j = 0; j < n; j++) {
            cout << adj[i][j] << "\t";
        }

        cout << endl;
    }

    return 0;
}
